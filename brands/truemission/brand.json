    "use": ["proteksi", "mendampingi", "siap", "kontribusi"],
    "avoid": ["Anda", "dijamin", "pasti cair", "termurah", "100% aman", "investasi"],
    "acronyms": ["BPJS", "IGD", "RS", "ICU", "MK"],
    "emoji_max": { "instagram": 2 },
    "exclamation": false,
    "all_caps_emphasis": false,
    "caption_formula": ["hook", "body", "proof", "cta"]
  },
  "hard_rules": {
    "no_prices": true,
    "claims_need_source": true,
    "no_client_names": true,
    "client_name_blocklist": [],
    "headline_case": "sentence",
    "headline_ends_with_period": false
