{
  "slug": "truemission",
  "name": "Truemission",
  "handle": "@truemission.id",
  "language": "id",
  "timezone": "Asia/Jakarta",
  "canvas": { "width": 1080, "height": 1350 },
  "palette": {
    "background_dark": "#AE0001",
    "background_light": "#F9F0EC",
    "accent": "#F9F0EC",
    "text_on_dark": "#FFFFFF",
    "text_on_light": "#000000",
    "muted": "#F9F0EC",
    "card": "#FFFFFF",
    "forbidden": []
  },
  "contrast_pairs": [
    { "fg": "#FFFFFF", "bg": "#AE0001", "min": 4.5 },
    { "fg": "#F9F0EC", "bg": "#AE0001", "min": 4.5 },
    { "fg": "#AE0001", "bg": "#F9F0EC", "min": 4.5 },
    { "fg": "#000000", "bg": "#F9F0EC", "min": 4.5 },
    { "fg": "#000000", "bg": "#FFFFFF", "min": 4.5 }
